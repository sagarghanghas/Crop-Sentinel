# CropSentinel Backend Environment Configuration
# Copy this file to .env and configure your credentials.
# Never commit real API keys to version control.

# AI Disease Detection Provider ("huggingface")
AI_PROVIDER=huggingface

# Hugging Face access token (get one at https://huggingface.co/settings/tokens)
# Create a fine-grained token with the "Make calls to Inference Providers" permission.
# Backend-only: never put this in frontend code or commit it. Placeholder below is NOT a real token.
# Leave blank to run without live AI inference (all other features will still work)
# (Legacy names HUGGINGFACE_API_KEY / HF_API_TOKEN are still read as fallbacks.)
HF_TOKEN=hf_your_token_here

# Hugging Face Plant Disease Classification Model ID
AI_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# SQLite Database URL
DATABASE_URL=sqlite+aiosqlite:///./cropsentinel.db

# Allowed Frontend Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Open-Meteo Public API Endpoints (no API key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Configurable Weather Risk Thresholds
WEATHER_RAIN_HIGH_MM=25.0
WEATHER_TEMP_HEAT_STRESS_C=36.0
WEATHER_TEMP_COLD_STRESS_C=6.0
WEATHER_HUMIDITY_FUNGAL_RISK_PCT=80.0
